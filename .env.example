# Movie & Series Website — environment variables (PLACEHOLDER VALUES ONLY)
#
# Copy this file to config.env for local development:
#   cp .env.example config.env
# then replace every placeholder below with your own real values.
# config.env is git-ignored and must NEVER be committed. The app loads
# it via dotenv in app.js:
#   dotenv.config({ path: "./config.env" })
#
# NOTE: the values that were previously committed in config.env are
# compromised. Rotating them in their dashboards is mandatory — see
# CONTAINMENT-PLAN.md. Filling this file in does not make the old
# values safe.
#
# MongoDB Atlas connection string (used by mongoose in app.js).
# Replace <username>, <password>, <cluster> and <database> with your own.
# For a local MongoDB instead, use: mongodb://localhost:27017/movie-and-series
CONNECTION_STRING=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
#
# JWT signing secret (used by signToken / protect in controllers/auth.js).
# Must be a long random string (at least 32 characters). Generate one with:
#   openssl rand -hex 32
# The old committed secret is compromised — generate a fresh one.
TOKEN_SIGNATURE=your_random_jwt_secret_at_least_32_characters_long
#
# JWT cookie lifetime, in days. NOTE: currently UNUSED at runtime — the
# cookie code in controllers/auth.js is commented out (the token is
# returned in the login JSON response instead). Keep the value here so
# it is ready if cookies are enabled later.
JWT_COOKIE_EXPIRES_IN=90
#
# Paymob payment gateway (used in controllers/user.js).
# Get both from your Paymob dashboard (Settings > Account Info / API Keys).
PAYMOB_API_KEY=your_paymob_api_key_here
PAYMOB_INTEGRATION_ID=your_paymob_integration_id_here
#
# PAYMOB_PAYMENT_KEY is NOT configured here: the app sets it at runtime
# from the Paymob auth-token response (process.env.PAYMOB_PAYMENT_KEY = ...).
# Do not put a payment token in this file.
